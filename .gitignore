# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js
/.next/
/out/
/build

# Production
/dist

# Misc
.DS_Store
*.pem
Thumbs.db

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Env files (never commit secrets)
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# IDE
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea
*.swp
*.swo

# Catalog source PDFs (large, kept locally only)
*.pdf

# Extracted catalog assets (regeneratable from import script)
/extracted

# Inspection/scratch scripts
inspect-pdf.cjs

# Supabase generated types
/lib/database.types.ts

# OS
ehthumbs.db

# Claude project-local config (user-specific)
.claude/settings.local.json

# Local-only Skills folder (user adds skills here, not part of repo)
/Skills

# Source git workflow doc (committed contents are encoded in .husky + .github)
Git Settings.txt

