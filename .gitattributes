# Enforce LF line endings for all text files (avoids Windows/Unix CRLF churn)
* text=auto eol=lf

# Shell scripts must always be LF (otherwise Husky hooks break)
*.sh text eol=lf
.husky/* text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.pdf binary
*.ico binary
*.woff binary
*.woff2 binary
