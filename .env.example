# =================================================================
# Furniture Catalog & WhatsApp Inquiry Platform
# Copy this file to `.env.local` and fill in real values for development.
# Never commit `.env.local` — it's in .gitignore.
# =================================================================

# ----- Site -----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----- WhatsApp -----
# Business WhatsApp number in international format, digits only, no '+' or spaces.
# Example for India: 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999

# ----- Supabase -----
# Get these from your Supabase project's API settings.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ----- Anthropic (only used by the catalog import script) -----
# Required when running scripts/import-jinglong.cjs to auto-generate descriptions.
ANTHROPIC_API_KEY=
